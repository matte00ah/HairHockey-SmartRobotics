<launch>
    <!-- Choose controller manager: fake, simple, or ros_control -->
    <arg name="use_sim_time" default="true"/>
    <arg name="robot_ip" default="172.16.0.2"/>
    
    
    <arg name="moveit_controller_manager" default="simple"/>
    
    <!-- Set execution mode for fake execution controllers -->
    <arg name="fake_execution_type" default="interpolate" />
    
    <!--include file="$(find franka_control)/launch/franka_control.launch" pass_all_args="true"/-->

    <!-- Robot description -->
    <param name="robot_description" command="$(find xacro)/xacro '$(find end_effector)/urdfs/robot_compose.urdf.xacro'"/>

    <param name="robot_description_semantic"
           textfile="$(find full_rbt_moveit)/config/full_robot.srdf"/>

    <!--Carica la configurazione dei solver cinematici -->
    <rosparam command="load" file="$(find full_rbt_moveit)/config/kinematics.yaml"/>    
    
    <rosparam file="$(find full_rbt_moveit)/config/ros_controllers.yaml" command="load"/>
    <node name="arm_controller_spawner" pkg="controller_manager" type="controller_manager" args="spawn robot_arm_controller" respawn="false" output="screen"/>

    <!-- MoveIt move_group -->
    <include file="$(find full_rbt_moveit)/launch/move_group.launch"/>

    <!-- Nodo per aggiungere oggetti nella planning scene -->
    <!--<node pkg="scene" type="scene_manager.py" name="scene_manager" output="screen"/>-->

    <!-- RViz -->
    <include file="$(find full_rbt_moveit)/launch/moveit_rviz.launch">
        <arg name="rviz_config" value="$(find full_rbt_moveit)/launch/moveit.rviz"/>
    </include>

    <node pkg="tf" type="static_transform_publisher" name="world_to_panda_tf"
        args="0 1.35 0.73 -1.571 0 0 world panda_link0 100" />
    
</launch>